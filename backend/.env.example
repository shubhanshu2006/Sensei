# SERVER CONFIGURATION
NODE_ENV=development
PORT=5000
API_VERSION=v1
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# DATABASE (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/sensei

# AUTHENTICATION (Clerk)
CLERK_SECRET_KEY=sk_test_xxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxx

# REDIS (WebSocket & Queue)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AWS S3 (File Storage)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET_NAME=sensei-resumes
AWS_REGION=ap-south-1

# AI (Google Gemini)
GOOGLE_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-pro

# PAYMENT (Razorpay)
# Use test credentials initially: rzp_test_xxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your_test_secret
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxx

# EMAIL (Brevo - formerly Sendinblue)
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=no-reply@sensei.dev
EMAIL_FROM_NAME=Sensei

# SECURITY
# IMPORTANT: Must be at least 32 characters in production
JWT_SECRET=your-secret-key-change-in-production-minimum-32-chars
SESSION_TIMEOUT_MINUTES=60

# INTERVIEW CONFIGURATION
INTERVIEW_MAX_QUESTIONS=10
INTERVIEW_CREDIT_CONSUMPTION_THRESHOLD=7
INTERVIEW_TIMEOUT_MINUTES=45

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# FINGERPRINT.JS (Abuse Prevention)
FINGERPRINT_API_KEY=
FINGERPRINT_PUBLIC_KEY=
